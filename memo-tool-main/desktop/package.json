{
  "name": "shared-memo-desktop",
  "version": "1.1.0",
  "description": "Shared Memo tray app for Mac and Windows",
  "private": true,
  "main": "main.cjs",
  "author": "Shared Memo",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:mac": "electron-builder --mac zip --arm64 --publish never",
    "build:win": "electron-builder --win zip --x64 --publish never"
  },
  "build": {
    "appId": "jp.sharedmemo.desktop",
    "productName": "Shared Memo",
    "files": [
      "*.cjs",
      "*.html",
      "icon.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": "zip"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
